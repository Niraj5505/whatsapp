{
  "name": "nexaflow",
  "version": "1.0.0",
  "description": "NexaFlow - Production-Ready WhatsApp Automation SaaS Platform",
  "main": "server/src/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "server:start": "npm --prefix server start",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix client install && npm --prefix client run build",
    "build:client": "npm --prefix client run build"
  },
  "keywords": ["whatsapp", "automation", "saas", "meta-api", "socketio", "mongodb", "express", "react"],
  "author": "NexaFlow",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
