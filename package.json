{
  "name": "nexaflow",
  "version": "1.0.0",
  "description": "NexaFlow - Production-Ready WhatsApp Automation SaaS Platform",
  "main": "server/src/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "server:start": "npm --prefix server start",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build"
  },
  "keywords": ["whatsapp", "automation", "saas", "meta-api", "socketio", "mongodb", "express", "react"],
  "author": "NexaFlow",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
